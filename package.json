{
  "name": "@carisma/site-account",
  "version": "0.1.0-local.1",
  "description": "Shared BFF + sealed-cookie kit that makes a Carisma brand website a relying party of the unified member-login identity origin.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js"
    },
    "./seal": {
      "types": "./dist/seal/index.d.ts",
      "import": "./dist/seal/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "import": "./dist/booking/index.js"
    },
    "./urls": {
      "types": "./dist/urls.d.ts",
      "import": "./dist/urls.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "verify:boundary": "node scripts/verify-account-boundary.mjs",
    "prepack": "npm run clean && npm run build && npm run verify:boundary",
    "test": "npm run build && npm run verify:boundary && node --test test/*.test.mjs",
    "demo:page": "node scripts/demo-page-server.mjs",
    "pack:local": "bash scripts/pack-local.sh"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
